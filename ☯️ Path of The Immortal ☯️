        req:1,
        cost:80,
        desc:"+25% Defense.",
        passive:"def"
    },

    {
        name:"Mountain Fist",
        quality:"Uncommon",
        req:1,
        cost:120,
        desc:"Attack for 1.8× Attack.",
        skill:1.8
    },

    {
        name:"Azure Sword",
