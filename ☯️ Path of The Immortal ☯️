<title>Path of the Immortal</title>

<style>
*{box-sizing:border-box}
body{
    margin:0;
    background:#070a10;
    color:#eee7d2;
    font-family:Georgia,serif;
}
header{
    text-align:center;
    padding:22px;
    background:linear-gradient(#171326,#090b11);
    border-bottom:1px solid #66552d;
}
h1{
    margin:0;
    color:#dfc56c;
    letter-spacing:3px;
}
.subtitle{color:#979181;margin-top:6px}
main{
    max-width:1450px;
    margin:auto;
    padding:15px;
    display:grid;
    grid-template-columns:300px minmax(400px,1fr) 310px;
    gap:15px;
}
.panel{
    background:#10151e;
    border:1px solid #363a42;
    border-radius:9px;
    padding:15px;
