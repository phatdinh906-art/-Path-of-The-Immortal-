/* =========================================================
   UPGRADES
========================================================= */

function upgrade(stat){

    const cost=upgradeCost(stat);


    if(game.stones<cost){

        notify(
            "Not enough Spirit Stones."
        );

        return;

    }


    game.stones-=cost;


    if(stat==="atk"){

        game.baseAtk++;

    }else{

        game.baseDef++;

    }


    notify(
        "Foundation strengthened."
    );

    update();

}


/* =========================================================
   EXPLORATION
========================================================= */

function renderAreas(){

    const box=document.getElementById("areas");

    box.innerHTML="";


    areas.forEach((area,index)=>{

        if(area.unknown && !game.unknownUnlocked){

            return;

        }


        let locked=false;


        if(!area.unknown){

            locked=game.realm<area.req;

        }


        if(area.unknown){

            box.innerHTML+=`

                <div class="card">
                    <strong>${area.name}</strong>

                    <p class="small">
                        Enemies scale with your
                        unbounded cultivation.
                    </p>

                    <button onclick="exploreUnknown()">
                        🌌 Enter the Unknown
                    </button>
                </div>

            `;

            return;

        }


        box.innerHTML+=`

            <div class="card ${locked?"locked":""}">

                <strong>${area.name}</strong>

                <p class="small">
                    Required Realm:
                    ${normalRealms[area.req].name}
                </p>

                <button
                    ${locked?"disabled":""}
                    onclick="explore(${index})"
                >
                    ${locked?"🔒 Locked":"🌌 Enter"}
                </button>

            </div>

        `;

    });

}


function explore(index){

    const area=areas[index];


    if(game.realm<area.req)return;


    if(chance(.25)){

        randomEvent(1);

        return;

    }


    const enemyIndex=
        area.enemies[
            rand(
                0,
                area.enemies.length-1
            )
        ];


    startCombat(enemyIndex);

    showTab("combat");

}


function exploreUnknown(){

    if(!game.unknownUnlocked){

        notify("The Unknown Realm is locked.");

        return;

    }


    startUnknownCombat();

    showTab("combat");

}


/* =========================================================
   UNKNOWN REALM COMBAT
========================================================= */

function startUnknownCombat(){

    const c=Math.max(
        1,
        game.cultivation
    );


    /*
       Enemy strength follows logarithmic cultivation scaling.
       This allows the player's numbers to grow enormously
       without creating impossible exponential explosions.
    */

    const scale=
        Math.max(
            1,
            Math.log10(c+10)
        );


    const names=[
        "Unknown Shadow",
        "Nameless Devourer",
        "Heavenless Beast",
        "Abyssal Entity",
        "???"
    ];


    const index=rand(
        0,
        names.length-1
    );


    const base=
        100*
        scale*
        prestigeMultiplier();


    game.enemy={

        name:names[index],

        realm:10,

        maxHp:base*(
            4+Math.random()*4
        ),

        hp:base*(
            4+Math.random()*4
        ),

        atk:base*.55,

        def:base*.22,

        xp:base*.7,

        stones:base*.5,

        unknown:true

    };


    game.combat=true;

    game.defending=false;


    log(
        "☠ Something beyond comprehension approaches.",
        "bad"
    );


    renderEnemy();

    update();

}


/* =========================================================
   RANDOM EVENTS
========================================================= */

function randomEvent(force=.1){

    if(!chance(force))return;


    const events=[

        ()=>{

            const gain=
                rand(10,40)*
                (game.realm+1)*
                prestigeMultiplier();

            game.stones+=gain;

            log(
                "🌿 You discover a hidden Spirit Stone vein.",
                "good"
            );

            notify(
                "+"+formatNumber(gain)+
                " Spirit Stones!"
            );

        },


        ()=>{

            const gain=
                rand(5,15)*
                (game.realm+1)*
                prestigeMultiplier();

            game.qi+=gain;

            game.cultivation+=gain;

            log(
                "☯ A spiritual spring nourishes your meridians.",
                "good"
            );

        },


        ()=>{

            game.hp=Math.min(
                effectiveMaxHp(),
                game.hp+
                effectiveMaxHp()*.25
            );

            log(
                "🌸 You discover a rare healing herb.",
                "good"
            );

        },


        ()=>{

            game.stones=
                Math.max(
                    0,
                    game.stones-rand(5,20)
                );

            log(
                "🐍 A venomous creature steals some Spirit Stones.",
                "bad"
            );

        }

    ];


    events[
        rand(
            0,
            events.length-1
        )
    ]();


    update();

}


/* =========================================================
   COMBAT
========================================================= */

function startCombat(index){

    const e=enemies[index];


    const scale=
        1+
        Math.max(
            0,
            game.realm-e.realm
        )*.12;


    game.enemy={

        ...e,

        maxHp:e.hp*scale,

        hp:e.hp*scale,

        atk:e.atk*scale,

        def:e.def*scale

    };


    game.combat=true;

    game.defending=false;


    log(
        "⚔ You encounter a "+
        e.name+"!",
        "bad"
    );


    renderEnemy();

    update();

}


function renderEnemy(){

    const e=game.enemy;


    if(!e){

        document.getElementById(
            "enemyArea"
        ).innerHTML=`
            <div class="card">
                <strong>No enemy.</strong>
            </div>
        `;

        return;

    }


    document.getElementById(
        "enemyArea"
    ).innerHTML=`

        <div class="enemy">

            <strong>☠ ${e.name}</strong>

            <div class="stat">
                <span>Realm</span>
                <span>
                    ${e.unknown
                        ?"???"
                        :normalRealms[e.realm].name}
                </span>
            </div>

            <div class="stat">
                <span>HP</span>
                <span>
                    ${formatNumber(Math.max(0,e.hp))}
                    /
                    ${formatNumber(e.maxHp)}
                </span>
            </div>

            <div class="bar">
                <div
                    class="fill hp"
                    style="width:${
                        Math.max(
                            0,
                            Math.min(
                                100,
                                e.hp/e.maxHp*100
                            )
                        )
                    }%"
                ></div>
            </div>

            <div class="stat">
                <span>Attack</span>
                <span>${formatNumber(e.atk)}</span>
            </div>

            <div class="stat">
                <span>Defense</span>
                <span>${formatNumber(e.def)}</span>
            </div>

        </div>

    `;


    document.getElementById(
        "combatControls"
    ).classList.toggle(
        "hidden",
        !game.combat
    );


    renderCombatTechniques();

}


function damage(attacker,defender){

    const raw=
        Math.max(
            1,
            attacker-defender*.55
        );


    return raw;

}


function playerAttack(){

    if(!game.combat)return;


    let dmg=
        damage(
            effectiveAtk(),
            game.enemy.def
        );


    const crit=chance(.12);


    if(crit){

        dmg*=2;

    }


    dmg=Math.floor(dmg);


    game.enemy.hp-=dmg;


    log(
        "⚔ You strike for "+
        formatNumber(dmg)+
        (crit
            ?" CRITICAL DAMAGE!"
            :" damage."),
        "good"
    );


    if(game.enemy.hp<=0){

        victory();

        return;

    }


    enemyTurn();

    update();

}


function defend(){

    if(!game.combat)return;


    game.defending=true;


    log(
        "🛡 You brace yourself.",
        "good"
    );


    enemyTurn();

}


function useTechnique(index){

    if(!game.combat)return;


    const t=techniques[index];


    if(!game.techniques.includes(index))return;


    if(!t.skill)return;


    let dmg=
        damage(
            effectiveAtk()*t.skill,
            game.enemy.def
        );


    if(chance(.15)){

        dmg*=2;

    }


    dmg=Math.floor(dmg);


    game.enemy.hp-=dmg;


    log(
        "📜 "+t.name+
        " deals "+
        formatNumber(dmg)+
        " damage!",
        "good"
    );


    if(t.burn && game.enemy.hp>0){

        const burn=
            effectiveAtk()*.5;

        game.enemy.hp-=burn;

        log(
            "🔥 Burning energy deals "+
            formatNumber(burn)+
            " additional damage.",
            "good"
        );

    }


    if(game.enemy.hp<=0){

        victory();

        return;

    }


    enemyTurn();

    update();

}


function enemyTurn(){

    if(!game.combat)return;


    let dmg=
        damage(
            game.enemy.atk,
            effectiveDef()
        );


    if(game.defending){

        dmg*=.35;

        game.defending=false;

    }


    if(chance(.08)){

        dmg*=2;

        log(
            "☠ "+
            game.enemy.name+
            " lands a CRITICAL HIT!",
            "bad"
        );

    }


    dmg=Math.floor(dmg);


    game.hp-=dmg;


    log(
        "☠ "+
        game.enemy.name+
        " hits you for "+
        formatNumber(dmg)+
        ".",
        "bad"
    );


    if(game.hp<=0){

        game.hp=1;

        game.stones*=.85;

        game.qi*=.8;

        game.combat=false;

        game.enemy=null;


        log(
            "☯ You barely escape with your life.",
            "bad"
        );


        notify(
            "Defeated — resources lost."
        );

    }


    renderEnemy();

}


/* =========================================================
   VICTORY
========================================================= */

function victory(){

    const e=game.enemy;


    game.combat=false;

    game.enemy=null;


    const multiplier=
        e.unknown
        ?prestigeMultiplier()
        :1+game.realm*.08;


    const stones=
        e.stones*multiplier;


    const xp=
        e.xp*multiplier;


    game.stones+=stones;

    game.xp+=xp;


    log(
        "🏆 Victory over "+
        e.name+"!",
        "good"
    );


    log(
        "+"+
        formatNumber(stones)+
        " Spirit Stones.",
        "gold"
    );


    log(
        "+"+
        formatNumber(xp)+
        " experience.",
        "good"
    );


    checkLevel();


    if(e.unknown){

        const qiGain=
            xp*
            Math.max(
                1,
                Math.log10(
                    game.cultivation+10
                )
            );


        game.qi+=qiGain;

        game.cultivation+=qiGain;


        log(
            "☯ You absorb residual Unknown energy.",
            "good"
        );

    }else if(chance(.18)){

        const qiGain=
            xp*
            (game.realm+1);


        game.qi+=qiGain;

        game.cultivation+=qiGain;


        log(
            "☯ You absorb residual spiritual energy.",
            "good"
        );

    }


    if(chance(.07)){

        findArtifact();

    }


    update();

}


/* =========================================================
   LEVELING
========================================================= */

function checkLevel(){

    while(game.xp>=xpNeeded()){

        game.xp-=xpNeeded();

        game.level++;

        game.baseAtk+=2;

        game.baseDef++;

        game.maxHp+=15;

        game.hp=effectiveMaxHp();


        log(
            "⭐ You reached level "+
            game.level+"!",
            "good"
        );

    }

}


/* =========================================================
   TECHNIQUES
========================================================= */

function renderTechniques(){

    const box=
        document.getElementById(
            "techList"
        );


    box.innerHTML="";


    techniques.forEach((t,i)=>{

        const owned=
            game.techniques.includes(i);


        const locked=
            !game.unknownUnlocked &&
            game.realm<t.req;


        let button;


        if(owned){

            button=
                `<button disabled>
                    ✓ Learned
                </button>`;

        }else if(locked){

            button=
                `<button disabled>
                    🔒 Requires
                    ${normalRealms[t.req].name}
                </button>`;

        }else{

            button=
                `<button onclick="learnTechnique(${i})">
                    Learn — 💠 ${formatNumber(t.cost)}
                </button>`;

        }


        box.innerHTML+=`

            <div class="tech ${
                locked&&!owned
                ?"locked"
                :""
            }">

                <strong>${t.name}</strong>

                <span class="small">
                    — ${t.quality}
                </span>

                <p class="small">
                    ${t.desc}
                </p>

                ${button}

            </div>

        `;

    });


    renderCombatTechniques();

}


function renderCombatTechniques(){

    const box=
        document.getElementById(
            "combatTechniques"
        );


    box.innerHTML="";


    if(!game.combat)return;


    game.techniques.forEach(index=>{

        const t=techniques[index];


        if(!t.skill)return;


        const button=
            document.createElement(
                "button"
            );


        button.className="full";

        button.textContent=
            "📜 "+t.name;

        button.onclick=
            ()=>useTechnique(index);


        box.appendChild(button);

    });

}


function learnTechnique(index){

    const t=techniques[index];


    if(game.techniques.includes(index))
        return;


    if(
        !game.unknownUnlocked &&
        game.realm<t.req
    ){

        notify(
            "Your realm is too low."
        );

        return;

    }


    if(game.stones<t.cost){

        notify(
            "Not enough Spirit Stones."
        );

        return;

    }


    game.stones-=t.cost;

    game.techniques.push(index);


    log(
        "📜 You learned "+
        t.name+"!",
        "good"
    );


    notify(
        "Technique learned."
    );


    update();

}


/* =========================================================
   ARTIFACTS
========================================================= */

function findArtifact(){

    const a=
        artifacts[
            rand(
                0,
                artifacts.length-1
            )
        ];


    if(game.equipment.includes(a.name)){

        game.stones+=100;

        log(
            "You found another "+
            a.name+
            " and sold it for 100 Spirit Stones.",
            "gold"
        );

        return;

    }


    game.equipment.push(a.name);


    log(
        "✨ Artifact discovered: "+
        a.name+
        " — "+
        a.desc,
        "good"
    );


    notify(
        "Rare artifact found!"
    );

}


function renderInventory(){

    const box=
        document.getElementById(
            "inventoryList"
        );


    if(game.equipment.length===0){

        box.innerHTML=`
            <div class="card small">
                Your inventory is empty.
            </div>
        `;

        return;

    }


    box.innerHTML="";


    game.equipment.forEach(name=>{

        const artifact=
            artifacts.find(
                a=>a.name===name
            );


        box.innerHTML+=`

            <div class="card">

                <strong>
                    ✨ ${artifact.name}
                </strong>

                <p class="small">
                    ${artifact.desc}
                </p>

            </div>

        `;

    });

}


/* =========================================================
   REALMS UI
========================================================= */

function renderRealms(){

    const box=
        document.getElementById(
            "realmList"
        );


    box.innerHTML="";


    normalRealms.forEach((realm,index)=>{

        let status;


        if(game.unknownUnlocked){

            status="✓ Surpassed";

        }else if(index<game.realm){

            status="✓ Completed";

        }else if(index===game.realm){

            status="☯ Current";

        }else{

            status="🔒 Locked";

        }


        box.innerHTML+=`

            <div class="realm-row">

                <span>
                    ${index+1}.
                    ${realm.name}
                </span>

                <span>
                    ${status}
                </span>

            </div>

        `;

    });


    box.innerHTML+=`

        <div class="realm-row">

            <span>
                ∞. ??? — Unknown Realm
            </span>

            <span>
                ${
                    game.unknownUnlocked
                    ?"☯ Current"
                    :"🔒 Locked"
                }
            </span>

        </div>

    `;

}


/* =========================================================
   HEAL
========================================================= */

function heal(){

    const max=effectiveMaxHp();

    const missing=
        Math.max(
            0,
            max-game.hp
        );


    if(missing<=0){

        notify(
            "Your body is already restored."
        );

        return;

    }


    const cost=
        Math.max(
            5,
            Math.floor(
                missing*.15
            )
        );


    if(game.stones<cost){

        notify(
            "Not enough Spirit Stones."
        );

        return;

    }


    game.stones-=cost;

    game.hp=max;


    notify(
        "Body restored."
    );


    update();

}


/* =========================================================
   SAVE / LOAD
========================================================= */

function saveGame(){

    game.lastSave=Date.now();


    localStorage.setItem(
        "pathOfTheImmortalSave",
        JSON.stringify(game)
    );


    notify(
        "Game saved."
    );

}


function loadGame(){

    const raw=
        localStorage.getItem(
            "pathOfTheImmortalSave"
        );


    if(!raw)return;


    try{

        const saved=
            JSON.parse(raw);


        game=
            Object.assign(
                structuredClone(defaultGame),
                saved
            );


        processOffline();


    }catch(error){

        console.error(
            "Save load failed:",
            error
        );

    }

}


/* =========================================================
   OFFLINE CULTIVATION
========================================================= */

function processOffline(){

    const now=Date.now();


    const seconds=
        Math.min(
            (now-game.lastSave)/1000,
            60*60*24
        );


    if(seconds>5){

        const gain=
            qiRate()*seconds;


        game.qi+=gain;

        game.cultivation+=gain;


        notify(
            "Offline cultivation: +"+
            formatNumber(gain)+
            " Qi"
        );

    }


    game.lastSave=now;

}


/* =========================================================
   TABS
========================================================= */

function showTab(id){

    [
        "cultivation",
        "combat",
        "explore",
        "techniques",
        "reincarnation",
        "inventory"
    ].forEach(tab=>{

        document
            .getElementById(tab)
            .classList.toggle(
                "hidden",
                tab!==id
            );

    });

}


/* =========================================================
   AUTOMATIC CULTIVATION
========================================================= */

setInterval(()=>{

    if(!game.combat){

        const gain=
            qiRate();


        game.qi+=gain;

        game.cultivation+=gain;


        /*
           In the Unknown Realm there is no threshold.
           Cultivation simply keeps growing.
        */

    }


    update();

},1000);


/* =========================================================
   AUTOSAVE
========================================================= */

setInterval(()=>{

    saveGame();

},30000);


/* =========================================================
   START
========================================================= */

loadGame();


log(
    "☯ Welcome, cultivator.",
    "good"
);


if(game.unknownUnlocked){

    log(
        "∞ You have entered the Unknown Realm.",
        "good"
    );

}else if(game.reincarnations>0){

    log(
        "☯ Reincarnation "+
        game.reincarnations+
        " — permanent power retained.",
        "good"
    );

}else{

    log(
        "Your journey toward immortality begins.",
        "good"
    );

}


update();

</script>

