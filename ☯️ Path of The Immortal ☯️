}
button{
    background:#171d29;
    color:#eee7d2;
    border:1px solid #665735;
    padding:10px 12px;
    border-radius:6px;
    cursor:pointer;
    font-weight:bold;
    transition:.15s;
}
button:hover{
    background:#292f3d;
    transform:translateY(-1px);
}
button:disabled{
    opacity:.35;
    cursor:not-allowed;
    transform:none;
}
.full{width:100%;margin:4px 0}
.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
}
.card{
    background:#151b26;
    border:1px solid #303641;
    border-radius:7px;
    padding:11px;
    margin:8px 0;
}
.stat{
    display:flex;
    justify-content:space-between;
    gap:10px;
    margin:7px 0;
    color:#aaa99e;
}
.stat strong,.value{color:#eee}
.bar{
    height:14px;
    background:#252a32;
    border:1px solid #3d4148;
    border-radius:10px;
    overflow:hidden;
    margin:5px 0 10px;
}
.fill{
    height:100%;
    width:0;
    transition:.25s;
}
.hp{background:#a94646}
.qi{background:#467ea6}
.cult{background:#a17e38}
.xp{background:#7766a5}
.small{
    font-size:12px;
    color:#99978c;
}
.tabs{
    display:flex;
    gap:5px;
    flex-wrap:wrap;
    margin-bottom:12px;
}
.tab{font-size:12px}
.hidden{display:none}
.log{
    height:230px;
    overflow-y:auto;
    background:#080b10;
    border:1px solid #30343c;
    padding:10px;
    font-size:13px;
}
.log div{margin-bottom:6px}
.good{color:#7dca8b}
.bad{color:#dc7272}
.gold{color:#e1c25c}
.enemy{
    background:#17130f;
    border:1px solid #604936;
    border-radius:8px;
    padding:12px;
    margin-bottom:10px;
}
.tech{
    background:#141923;
    border:1px solid #393d47;
    border-radius:7px;
    padding:10px;
    margin:7px 0;
}
.locked{opacity:.45}
.realm-row{
    display:flex;
    justify-content:space-between;
    padding:5px 0;
    font-size:13px;
}
.notice{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:20;
