/* =========================================================
   BREAKTHROUGH
========================================================= */

function breakthrough(){

    if(game.unknownUnlocked){

        notify(
            "The Unknown Realm has no finite breakthrough threshold."
        );

        return;

    }


    const req=normalRealms[game.realm].req;


    /*
       Immortal Ascension is special.
       It is the final normal realm and must be completely maxed
       before reincarnation or Unknown Realm progression.
    */

    if(game.realm===normalRealms.length-1){

        if(game.cultivation<req){

            notify(
                "Immortal Ascension is not completely maxed."
            );

            return;

        }


        if(game.reincarnations<10){

            notify(
                "You need "+
                (10-game.reincarnations)+
                " more reincarnation(s)."
            );

            return;

        }


        game.unknownUnlocked=true;

        game.qi=0;

        game.cultivation=1;

        game.maxHp*=10;

        game.hp=effectiveMaxHp();

        game.baseAtk*=5;

        game.baseDef*=5;

        log(
            "☯ THE HEAVENS HAVE BEEN SURPASSED.",
            "good"
        );

        log(
            "You have entered the ??? — Unknown Realm.",
            "good"
        );

        notify("UNKNOWN REALM UNLOCKED!");

        update();

        return;

    }


    if(game.cultivation<req){

        notify(
            "Insufficient cultivation."
        );

        return;

    }


    const successChance=
        Math.min(
            .92,
            .45+game.realm*.045
        );


    if(chance(successChance)){

        const old=normalRealms[game.realm];

        game.realm++;

        game.qi=0;

        game.cultivation=0;

        game.baseAtk*=1.18;

        game.baseDef*=1.18;

        game.maxHp*=1.15;

        game.hp=effectiveMaxHp();

        log(
            "☯ Breakthrough successful: "+
            normalRealms[game.realm].name,
            "good"
        );

        notify(
            "Breakthrough successful!"
        );

    }else{

        game.cultivation*=.72;

        game.qi*=.8;

        game.hp=Math.max(
            1,
            game.hp*.65
        );

        log(
            "☯ Breakthrough failed. Your cultivation slips.",
            "bad"
        );

        notify("Breakthrough failed.");

    }

    update();

}


/* =========================================================
   REINCARNATION
========================================================= */

function reincarnate(){

    if(game.unknownUnlocked){

        notify(
            "You have already surpassed reincarnation."
        );

        return;

    }


    const finalRealm=
        normalRealms.length-1;


    /*
       Requirement 1:
       Must be Immortal Ascension.
    */

    if(game.realm!==finalRealm){

        const remaining=
            normalRealms[finalRealm].req-
            game.cultivation;

        notify(
            "You must reach Immortal Ascension first."
        );

        log(
            "☯ Reincarnation unavailable: current realm is "+
            normalRealms[game.realm].name+".",
            "bad"
        );

        log(
            "You still need "+formatNumber(Math.max(0,remaining))+
            " cultivation in the final realm.",
            "bad"
        );

        return;

    }


    /*
       Requirement 2:
       Must completely max Immortal Ascension.
    */

    if(
        game.cultivation<
        normalRealms[finalRealm].req
    ){

        const remaining=
            normalRealms[finalRealm].req-
            game.cultivation;

        notify(
            "Immortal Ascension is not maxed."
        );

        log(
            "☯ You need "+
            formatNumber(remaining)+
            " more cultivation to reincarnate.",
            "bad"
        );

        return;

    }


    const nextCount=
        game.reincarnations+1;


    const confirmed=confirm(

        "☯ REINCARNATE?\n\n"+
        "You will return to Mortal.\n\n"+
        "Your normal cultivation, realm, XP, "+
        "Spirit Stones, techniques, and equipment "+
        "will reset.\n\n"+
        "Your permanent reincarnation count and "+
        "prestige power will remain.\n\n"+
        "Reincarnation: "+
        game.reincarnations+
        " → "+
        nextCount+
        "\n\n"+
        "Permanent bonus after reincarnation: "+
        formatMultiplier(
            Math.pow(1.25,nextCount)
        )+
        "\n\n"+
        (
            nextCount>=10
            ?"After reaching 10 reincarnations, "+
             "you can eventually break beyond Immortal Ascension."
            :""
        )

    );


    if(!confirmed)return;


    /*
       Preserve only permanent progression.
    */

    game.reincarnations=nextCount;


    /*
       Reset temporary progression.
    */

    game.realm=0;

    game.level=1;

    game.qi=0;

    game.cultivation=0;

    game.xp=0;

    game.stones=100;

    game.baseAtk=10;

    game.baseDef=5;

    game.hp=100;

    game.maxHp=100;

    game.techniques=[0];

    game.equipment=[];

    game.combat=false;

    game.enemy=null;

    game.defending=false;

    game.lastSave=Date.now();


    log(
        "☯ Reincarnation "+game.reincarnations+
        " completed.",
        "good"
    );

    log(
        "Your memories fade, but your eternal foundation remains.",
        "good"
    );

    notify(
        "Reincarnation successful!"
    );


    update();

    saveGame();

}


function formatMultiplier(value){

    return "×"+value.toFixed(3);

}


