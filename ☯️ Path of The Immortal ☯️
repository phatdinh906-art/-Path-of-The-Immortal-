        req:7,
        cost:15000,
        desc:"Attack for 7× Attack.",
        skill:7
    }

];


/* =========================================================
   ARTIFACTS
========================================================= */

const artifacts = [

    {
        name:"Jade Spirit Ring",
        desc:"+15% Qi generation"
    },

    {
        name:"Iron Guardian Talisman",
        desc:"+20 Defense"
    },

    {
        name:"Heavenly Sword Fragment",
        desc:"+30 Attack"
    },

    {
        name:"Phoenix Feather",
        desc:"+10% maximum HP"
    }

];


/* =========================================================
   GAME STATE
========================================================= */

const defaultGame = {

    realm:0,

    level:1,

    qi:0,

    cultivation:0,

    xp:0,

    stones:100,

    baseAtk:10,

    baseDef:5,

    hp:100,

    maxHp:100,

    techniques:[0],

    equipment:[],

    reincarnations:0,

    unknownUnlocked:false,

    lastSave:Date.now(),

    combat:false,

    enemy:null,

    defending:false

};


let game = structuredClone(defaultGame);


/* =========================================================
   NUMBER SYSTEM
========================================================= */

function formatNumber(value){

    if(!Number.isFinite(value)){
        return "∞";
    }

    const abs=Math.abs(value);

    if(abs<1000){
        return Math.floor(value).toLocaleString();
    }

    const suffix=[
        "",
        "K",
        "M",
        "B",
        "T",
        "Qa",
        "Qi",
        "Sx",
        "Sp",
        "Oc",
        "No",
        "Dc"
    ];

    const tier=Math.floor(Math.log10(abs)/3);

    if(tier>=suffix.length){
        return value.toExponential(3);
    }

    return (value/Math.pow(1000,tier)).toFixed(2)+suffix[tier];

}


/*
    Unknown Realm values can become enormous.
    The game intentionally does not impose a finite progression
    threshold once the Unknown Realm has been reached.
*/

function safePower(base,exponent){

    const result=base**exponent;

    if(!Number.isFinite(result)){
        return Number.MAX_VALUE;
    }

    return result;
}


/* =========================================================
   REALM HELPERS
========================================================= */

function currentRealm(){

    if(game.unknownUnlocked){

        return {
            name:"??? — Unknown Realm",
            unknown:true
        };

    }

    return normalRealms[game.realm];

}


function prestigeMultiplier(){

    /*
       Every reincarnation gives +25%.

       0 reincarnations = ×1
       1 = ×1.25
       2 = ×1.5625
       10 = ×9.313...
    */

    return Math.pow(1.25,game.reincarnations);

}


function unknownPower(){

    if(!game.unknownUnlocked){
        return 1;
    }

    /*
       Cultivation itself becomes the progression scale.

       log10 prevents ordinary Number values from exploding
       too quickly while still allowing effectively endless growth.
    */

    const c=Math.max(1,game.cultivation);

    return 180 *
        Math.max(1,Math.log10(c+10)) *
        prestigeMultiplier();

}


function realmMultiplier(){

    if(game.unknownUnlocked){

        return unknownPower();

    }

    return normalRealms[game.realm].mult *
        prestigeMultiplier();

}


/* =========================================================
   STATS
========================================================= */

function effectiveAtk(){

    let value=game.baseAtk*realmMultiplier();

    if(game.equipment.includes("Heavenly Sword Fragment")){
        value+=30;
    }

    return value;

}


function effectiveDef(){

    let value=game.baseDef*realmMultiplier();

    if(game.techniques.includes(1)){
        value*=1.25;
    }

    if(game.equipment.includes("Iron Guardian Talisman")){
        value+=20;
    }

    return value;

}


function effectiveMaxHp(){

    let value=game.maxHp*realmMultiplier();

    if(game.equipment.includes("Phoenix Feather")){
        value*=1.10;
    }

    return value;

}


function qiRate(){

    let rate=.8*realmMultiplier();

    if(game.techniques.includes(0)){
        rate*=1.2;
    }

    if(game.equipment.includes("Jade Spirit Ring")){
        rate*=1.15;
    }

    return rate;

}


function xpNeeded(){

    return Math.floor(
        100*Math.pow(game.level,1.65)
    );

}


function upgradeCost(stat){

    const base=stat==="atk"?50:60;

    const value=stat==="atk"
        ? game.baseAtk
        : game.baseDef;

    return Math.floor(
        base*Math.pow(
            value/(stat==="atk"?10:5),
            1.35
        )
    );

}


/* =========================================================
   NOTIFICATIONS
========================================================= */

function notify(text){

    const n=document.getElementById("notice");

    n.textContent=text;

    n.classList.add("show");

    setTimeout(()=>{
        n.classList.remove("show");
    },1800);

}


function log(text,cls=""){

    const box=document.getElementById("log");

    const div=document.createElement("div");

    div.className=cls;

    div.textContent=text;

    box.appendChild(div);

    box.scrollTop=box.scrollHeight;

}


/* =========================================================
   RANDOM
========================================================= */

function rand(min,max){

    return Math.floor(
        Math.random()*(max-min+1)
    )+min;

}


function chance(probability){

    return Math.random()<probability;

}


/* =========================================================
   UI UPDATE
========================================================= */

function update(){

    const realm=currentRealm();

    document.getElementById("realm").textContent=realm.name;

    document.getElementById("level").textContent=
        game.level;

    document.getElementById("atk").textContent=
        formatNumber(effectiveAtk());

    document.getElementById("def").textContent=
        formatNumber(effectiveDef());

    document.getElementById("stones").textContent=
        formatNumber(game.stones);


    /*
       HP is unbounded in Unknown Realm.
       Instead of a finite bar, display infinity.
    */

    if(game.unknownUnlocked){

        document.getElementById("hpText").textContent=
            formatNumber(game.hp)+" / ∞";

        document.getElementById("hpBar").style.width="100%";

        document.getElementById("qiText").textContent=
            formatNumber(game.qi)+" / ∞";

        document.getElementById("qiBar").style.width="100%";

        document.getElementById("cultText").textContent=
            formatNumber(game.cultivation)+" / ∞";

        document.getElementById("cultBar").style.width="100%";

    }else{

        const req=normalRealms[game.realm].req;

        document.getElementById("hpText").textContent=
            formatNumber(game.hp)+" / "+
            formatNumber(effectiveMaxHp());

        document.getElementById("hpBar").style.width=
            Math.min(
                100,
                game.hp/effectiveMaxHp()*100
            )+"%";


        document.getElementById("qiText").textContent=
            formatNumber(game.qi)+" / "+
            formatNumber(req);

        document.getElementById("qiBar").style.width=
            Math.min(
                100,
                game.qi/req*100
            )+"%";


        document.getElementById("cultText").textContent=
            formatNumber(game.cultivation)+" / "+
            formatNumber(req);

        document.getElementById("cultBar").style.width=
            Math.min(
                100,
                game.cultivation/req*100
            )+"%";

    }


    document.getElementById("xpText").textContent=
        formatNumber(game.xp)+" / "+
        formatNumber(xpNeeded());

    document.getElementById("xpBar").style.width=
        Math.min(
            100,
            game.xp/xpNeeded()*100
        )+"%";


    document.getElementById("qiRate").textContent=
        formatNumber(qiRate())+" Qi/sec";


    if(game.unknownUnlocked){

        document.getElementById("nextReq").textContent=
            "∞ — Unbounded";

    }else{

        const next=normalRealms[game.realm+1];

        if(next){

            document.getElementById("nextReq").textContent=
                formatNumber(next.req)+" cultivation";

        }else{

            if(game.reincarnations<10){

                document.getElementById("nextReq").textContent=
                    "Reincarnate "+(10-game.reincarnations)+
                    " more time(s)";

            }else{

                document.getElementById("nextReq").textContent=
                    "Unknown Realm";

            }

        }

    }


    document.getElementById("atkCost").textContent=
        formatNumber(upgradeCost("atk"));

    document.getElementById("defCost").textContent=
        formatNumber(upgradeCost("def"));


    updateReincarnationUI();

    renderRealms();

    renderTechniques();

    renderInventory();

    renderAreas();

    if(game.enemy){
        renderEnemy();
    }

}


